# Kopjoje si .env (vetëm për provë lokale) ose vendosi këto te Vercel → Settings → Environment Variables.
# MOS e vendos kurrë .env në Git. Kredencialet qëndrojnë vetëm në server.

# ---------- Ruajtja e dorëzimeve (e detyrueshme për dorëzime reale) ----------
# Në Vercel: krijo një Blob store PRIVAT dhe lidhe me projektin. Vercel shton vetë
# BLOB_READ_WRITE_TOKEN ose BLOB_STORE_ID; nuk ke nevojë t'i shkruash me dorë.
STORAGE_DRIVER=vercel-blob
# BLOB_READ_WRITE_TOKEN=   (vendoset automatikisht nga Vercel kur lidh store-in)

# Vetëm për provë në kompjuterin tënd (refuzohet në Vercel):
# STORAGE_DRIVER=file
# STORAGE_DIR=./.data

# Pa STORAGE_DRIVER dhe pa store të lidhur: dorëzimet vetëm SIMULOHEN dhe NUK ruhen.

# ---------- Hyrja në panelin privat (/admin) ----------
# Të paktën 16 shenja. Ndryshimi i tij i mbyll të gjitha sesionet e hapura.
ADMIN_PASSWORD=
# Të paktën 32 shenja të rastësishme, p.sh. nga: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ---------- Njoftim opsional për dorëzime të reja (pa përgjigje, pa foto) ----------
# Lëre bosh nëse nuk do njoftim. Dorëzimi ruhet njësoj edhe kur njoftimi dështon.
NOTIFY_EMAIL_TO=
# PANEL_URL=https://pyetesori.funnelmcqueen.com
# Me Resend:
# RESEND_API_KEY=
# EMAIL_FROM=Pyetësori XAUUSD <pyetesori@funnelmcqueen.com>
# Ose me SMTP:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
